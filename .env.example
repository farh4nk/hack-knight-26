# Tiger Data / PostgreSQL Connection String
# Example: postgresql://username:password@host.tigerdata.com:5432/cradleecho?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cradleecho

# Gemini API Key (Task 4.3)
# Get your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Dev 1 Telemetry WebSocket Endpoint (Task 4.2)
TELEMETRY_WS_URL=ws://localhost:8000/ws/telemetry

# Ingestion Batch Interval (seconds)
INGESTION_INTERVAL_SECONDS=5
